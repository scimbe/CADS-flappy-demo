# Origin for the flappy-demo.bunsenbrenner.org demo — same shape as the
# help.bunsenbrenner.org demo (examples/help-site): Caddy terminates TLS, so
# it needs NO inbound :80/:443 of its own. The Browser-Plane agent forwards
# the raw TLS here; TLS terminates at this origin, keeping the edge/plane
# payload-blind.
#
# #219: the cert is issued CORE-side (scripts/authorize-pipeline.sh, deSEC
# DNS-01 with the operator's zone-wide token) and mounted in as static files
# — this Caddyfile only ever reads fullchain.pem/privkey.pem, never holds a
# DNS credential of its own.

flappy-demo.bunsenbrenner.org {
	# #173 distributed crew: the studio page POSTs its prompt here; the crew bridge runs the
	# safety→physics→art crew over the tunnel and returns {safety, auction, config}. A more
	# specific matcher than the file_server below, so Caddy routes it first.
	reverse_proxy /crew/build flappy-crew-bridge:8788
	root * /srv
	file_server
	encode gzip
	tls /certs/fullchain.pem /certs/privkey.pem
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}
